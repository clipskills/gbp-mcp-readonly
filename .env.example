# Google OAuth client (Desktop or Web). Do not commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8753/
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token

# Optional: skip the local OAuth helper if you already have a user token
# GOOGLE_ACCESS_TOKEN=
# GOOGLE_REFRESH_TOKEN=
# GMB_MCP_TOKEN_PATH=.gmb-mcp-token.json

# Optional HTTP transport
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8765
